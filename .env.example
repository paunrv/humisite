# Supabase (https://supabase.com/dashboard/project/_/settings/api)
# Copy to .env.local and fill with your project values.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Prefer the new publishable key from Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Legacy anon JWT key (optional fallback if publishable key is not available yet)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-only — never expose to the browser / never prefix with NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# HUMI-tec Stripe price IDs (wired in humi-sistema Checkout; see docs/HUMI_TEC_PRICING.md)
# STRIPE_PRICE_ESCUELA_MONTHLY=price_...
# STRIPE_PRICE_ESCUELA_YEARLY=price_...
# STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
# STRIPE_PRICE_ENTERPRISE_YEARLY=price_...

# NEXT_PUBLIC_SITE_URL=https://humisite.vercel.app

# Product app (humi-sistema) — CTAs /tec Entrar / redirects /login /app
# Pilot (DNS app.humi.mx not ready yet):
# NEXT_PUBLIC_PRODUCT_URL=https://humi-sistema.vercel.app
# After branded domain is live:
# NEXT_PUBLIC_PRODUCT_URL=https://app.humi.mx

