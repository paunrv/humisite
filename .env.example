# Supabase (https://supabase.com/dashboard/project/_/settings/api)
# Copy to .env.local and fill with your project values.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Prefer the new publishable key from Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Legacy anon JWT key (optional fallback if publishable key is not available yet)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-only — never expose to the browser / never prefix with NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
